{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["gaps", "adversarial_queries"],
  "properties": {
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "is_searchable", "queries"],
        "properties": {
          "description": {"type": "string"},
          "is_searchable": {"type": "boolean"},
          "queries": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "adversarial_queries": {"type": "array", "items": {"type": "string"}}
  }
}
