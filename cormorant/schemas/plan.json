{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["angles", "execution_order"],
  "properties": {
    "angles": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "key_questions", "search_seeds", "priority", "depends_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^S0[1-8]$"},
          "title": {"type": "string"},
          "key_questions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "search_seeds": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "priority": {"type": "integer"},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "execution_order": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 8,
      "maxItems": 8
    }
  }
}
